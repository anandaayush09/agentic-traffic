# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# Generated / DVC-tracked data (see docs/design/08_data_strategy.md).
# Raw OSM source extracts ARE committed (small, and re-fetching from Overpass would
# silently drift as OSM data is edited over time) -- everything *derived* from them
# (net.net.xml, routes) is regenerated by scripts/ and gitignored.
data/networks/*
!data/networks/.gitkeep
!data/networks/manhattan_midtown/
data/networks/manhattan_midtown/*
!data/networks/manhattan_midtown/raw.osm.xml
!data/networks/manhattan_midtown/AUDIT.md

# SUMO outputs
*.xml.gz
*-output.xml
# Week 11 evaluation pilot's real tripinfo output (regenerated by
# scripts/run_evaluation_pilot.py; ~100MB for 150 real runs, not something to commit --
# the pilot report's own claims table is the artifact that matters, not the raw XML
# every metric in it was computed from).
data/eval_pilot_tripinfo/

# MLflow / experiment artifacts
mlruns/
mlartifacts/

# Trained model checkpoints (regenerable via scripts/train_*.py)
data/models/
data/checkpoints/

# Ultralytics YOLO: auto-downloaded pretrained checkpoints + its own run output dir
yolov8*.pt
yolo11*.pt
runs/

# Env files with secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node (frontend, added in later weeks)
node_modules/
dist/
