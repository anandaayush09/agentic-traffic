# Copy to .env and adjust. Never commit the real .env file.
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_FORMAT=console

# --- LLM playbook proposals (all optional; with no keys the deterministic mapper is used) ---
# Keys go ONLY in your local .env (gitignored) -- never commit them, never paste them in chat.
GROQ_API_KEY=
GEMINI_API_KEY=
# Free-tier caps differ per model and change; set what YOUR account shows. Defaults are conservative.
# ATLAS_GROQ_MODEL=llama-3.1-8b-instant
# ATLAS_GEMINI_MODEL=gemini-2.5-flash
# ATLAS_GROQ_RPM=30
# ATLAS_GROQ_RPD=14400
# ATLAS_GEMINI_RPM=10
# ATLAS_GEMINI_RPD=250
# Shared rate-limit state (docker compose up -d redis); in-memory fallback if unreachable.
# ATLAS_REDIS_URL=redis://localhost:6379/0
